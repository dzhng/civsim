{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "bun install --cwd web&&rustup target add wasm32-unknown-unknown&&curl https://rustwasm.github.io/wasm-pack/installer/init.sh -sSf|sh",
  "buildCommand": "bun run build",
  "outputDirectory": "web/dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    },
    {
      "source": "/assets/soldiers/appearances/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/battle",
      "destination": "/index.html"
    },
    {
      "source": "/battle/run",
      "destination": "/index.html"
    },
    {
      "source": "/campaign",
      "destination": "/index.html"
    }
  ]
}
