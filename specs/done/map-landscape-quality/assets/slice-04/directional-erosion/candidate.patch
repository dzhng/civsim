@@ -0,0 +1,89 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/.
+ *
+ * Copyright 2025 Rune Skovbo Johansen; Copyright 2023 Fewes;
+ * Copyright 2020 Clay John; port additions Copyright 2026 Korbin de Man.
+ * Adapted from bevy_erosion_filter, commit 494b366960eec25604a56e05e56acdc2d6a62429.
+ * https://blog.runevision.com/2026/03/fast-and-gorgeous-erosion-filter.html
+ * The local adaptation keeps two octaves and returns height only.
+ */
+
+const tau = Math.PI * 2;
+const clamp01 = (v: number) => Math.max(0, Math.min(1, v));
+const easeOut = (v: number) => 1 - (1 - clamp01(v)) ** 2;
+const smoothStart = (v: number, smoothing: number) =>
+  v >= smoothing ? v - smoothing * 0.5 : (v * v * 0.5) / smoothing;
+const fract = (v: number) => v - Math.floor(v);
+
+/** Cell-blended phase; outputs cosine, sine and their shared side direction. */
+export function phacelleNoise(x: number, y: number, nx: number, ny: number) {
+  const sideX = -ny * 0.7 * tau,
+    sideY = nx * 0.7 * tau;
+  const ix = Math.floor(x),
+    iy = Math.floor(y),
+    fx = x - ix,
+    fy = y - iy;
+  let cosine = 0,
+    sine = 0,
+    weights = 0;
+  for (let i = -1; i <= 2; i++) {
+    for (let j = -1; j <= 2; j++) {
+      // IQ's hash, retained so phase placement matches the reference kernel.
+      const hx = (ix + i) * 0.3183099 + 0.3678794;
+      const hy = (iy + j) * 0.3678794 + 0.3183099;
+      const h = fract(hx * hy * (hx + hy));
+      const vx = fx - i - (fract(16 * 0.3183099 * h) - 0.5);
+      const vy = fy - j - (fract(16 * 0.3678794 * h) - 0.5);
+      const weight = Math.max(0, Math.exp(-(vx * vx + vy * vy) * 2) - 0.01111);
+      const phase = vx * sideX + vy * sideY + tau * 0.25;
+      cosine += Math.cos(phase) * weight;
+      sine += Math.sin(phase) * weight;
+      weights += weight;
+    }
+  }
+  cosine /= weights;
+  sine /= weights;
+  const magnitude = Math.max(0.5, Math.hypot(cosine, sine));
+  return [cosine / magnitude, sine / magnitude, sideX, sideY] as const;
+}
+
+/** Stateless slope-guided relief. Internal slopes guide branches, not normals. */
+export function erodedHeight(
+  x: number,
+  y: number,
+  height: number,
+  dx: number,
+  dy: number,
+  fade: number,
+) {
+  const scale = 32;
+  let strength = 0.22 * scale,
+    frequency = 1 / (scale * 0.7);
+  const slope = Math.max(1e-10, Math.hypot(dx, dy));
+  let gx = (dx / slope) * 0.7,
+    gy = (dy / slope) * 0.7;
+  let target = Math.max(-1, Math.min(1, fade));
+  const inputRounding = 0.1 * clamp01(target + 0.5) * 0.1;
+  let mask = easeOut(smoothStart(slope * 1.25, inputRounding * 1.25));
+  let rounding = 1;
+  let result = height;
+  for (let octave = 0; octave < 2; octave++) {
+    const gl = Math.max(1e-10, Math.hypot(gx, gy));
+    const n = phacelleNoise(x * frequency, y * frequency, gx / gl, gy / gl);
+    const px = -n[2] * frequency,
+      py = -n[3] * frequency;
+    gx += Math.sign(n[1]) * px * strength * 0.5;
+    gy += Math.sign(n[1]) * py * strength * 0.5;
+    const faded = target + (n[0] * 0.5 - target) * mask;
+    result += faded * strength;
+    target = faded;
+    const round = 0.1 * clamp01(n[0] + 0.5) * rounding;
+    const nextMask = easeOut(smoothStart(Math.abs(n[1]) * 1.25, round * 1.25));
+    mask = (1 - (1 - clamp01(mask)) ** 1.5) * nextMask;
+    strength *= 0.5;
+    frequency *= 2;
+    rounding *= 2;
+  }
+  return result;
+}
