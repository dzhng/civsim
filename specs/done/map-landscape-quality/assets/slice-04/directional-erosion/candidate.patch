diff --git a/web/tests/erosion.test.ts b/web/tests/erosion.test.ts
new file mode 100644
index 00000000..d76bff3c
--- /dev/null
+++ b/web/tests/erosion.test.ts
@@ -0,0 +1,125 @@
+import { expect, it } from "vitest";
+import { erodedHeight, phacelleNoise } from "../../packages/game-renderer/src/terrain/erosion";
+import { campaignNoise } from "../../packages/game-renderer/src/terrain/campaignRelief";
+
+it("preserves the published Phacelle kernel and two-octave filter output", () => {
+  // Independent oracle: cpu.rs from bevy_erosion_filter commit 494b3669,
+  // compiled with only numeric types widened to f64 to match JavaScript.
+  const cases = [
+    {
+      p: [0.13, 0.27],
+      wave: [-0.4400433969630528, 0.586667292689296],
+      height: 9.368594724009197,
+    },
+    {
+      p: [1.7, -3.2],
+      wave: [0.9426044762351157, -0.33391136755361217],
+      height: 10.67912834650598,
+    },
+    {
+      p: [-0.4, 0.75],
+      wave: [0.931238482732146, -0.09034899003081194],
+      height: 9.533816868084504,
+    },
+    {
+      p: [50.5, 77.25],
+      wave: [-0.17024601236762593, -0.914424651032231],
+      height: 4.910472992960507,
+    },
+    {
+      p: [-127.3, 200.7],
+      wave: [-0.5799648648959226, 0.7925646821179709],
+      height: 10.396284758041018,
+    },
+  ];
+  for (const {
+    p: [x, y],
+    wave,
+    height,
+  } of cases) {
+    const actual = phacelleNoise(x, y, 0.6, -0.8);
+    for (let i = 0; i < 2; i++) expect(Math.abs(actual[i] - wave[i])).toBeLessThan(1e-10);
+    expect(Math.abs(erodedHeight(x, y, 10, 0.6, -0.8, 0.3) - height)).toBeLessThan(1e-10);
+  }
+});
+
+it("uses analytic noise gradients consistent with heights across lattice edges", () => {
+  const step = 1e-5;
+  for (const [x, y] of [
+    [0.13, 0.27],
+    [1, -3],
+    [-0.0001, 2.3],
+    [1.7, -3.2],
+  ]) {
+    const gradient: [number, number] = [0, 0];
+    expect(campaignNoise(x, y, gradient)).toBe(campaignNoise(x, y));
+    expect(gradient[0]).toBeCloseTo(
+      (campaignNoise(x + step, y) - campaignNoise(x - step, y)) / (2 * step),
+      6,
+    );
+    expect(gradient[1]).toBeCloseTo(
+      (campaignNoise(x, y + step) - campaignNoise(x, y - step)) / (2 * step),
+      6,
+    );
+  }
+});
+
+it("keeps filtered height continuous across source-height cell boundaries", async () => {
+  const { coastalRidgeFixture } =
+    await import("../../apps/renderer-lab/src/routes/landscapeFixtures");
+  const { campaignRelief } =
+    await import("../../packages/game-renderer/src/terrain/campaignRelief");
+  const field = campaignRelief(coastalRidgeFixture());
+  // Reproduced a 9.82km height jump here when the filter consumed the
+  // discontinuous gradient of a bilinear source-height reconstruction.
+  const step = 1e-7;
+  for (const [x, y] of [
+    [16, 73.04],
+    [8, 10],
+    [0, 12],
+  ]) {
+    expect(Math.abs(field.heightAt(x - step, y) - field.heightAt(x + step, y))).toBeLessThan(1e-4);
+    expect(Math.abs(field.heightAt(x, y - step) - field.heightAt(x, y + step))).toBeLessThan(1e-4);
+  }
+});
+
+it("reconstructs source nodes exactly with continuous analytic height gradients", async () => {
+  const { coastalRidgeFixture } =
+    await import("../../apps/renderer-lab/src/routes/landscapeFixtures");
+  const { campaignHeightSample } =
+    await import("../../packages/game-renderer/src/terrain/campaignRelief");
+  const source = coastalRidgeFixture(),
+    gradient: [number, number] = [0, 0];
+  for (let j = 0; j < source.h; j++)
+    for (let i = 0; i < source.w; i++) {
+      const x = source.minX + (i + 0.5) * source.cell,
+        y = source.maxY - (j + 0.5) * source.cell;
+      expect(campaignHeightSample(source, x, y, gradient)).toBe(source.height[j * source.w + i]);
+    }
+  const step = 1e-5;
+  for (const [x, y] of [
+    [16, 73.04],
+    [-20.5, 7.3],
+    [-160, 1],
+    [160, 1],
+  ]) {
+    campaignHeightSample(source, x, y, gradient);
+    const [dx, dy] = gradient;
+    expect(dx).toBeCloseTo(
+      (campaignHeightSample(source, x + step, y, gradient) -
+        campaignHeightSample(source, x - step, y, gradient)) /
+        (2 * step),
+      5,
+    );
+    expect(dy).toBeCloseTo(
+      (campaignHeightSample(source, x, y + step, gradient) -
+        campaignHeightSample(source, x, y - step, gradient)) /
+        (2 * step),
+      5,
+    );
+    campaignHeightSample(source, x - step, y, gradient);
+    const leftDx = gradient[0];
+    campaignHeightSample(source, x + step, y, gradient);
+    expect(gradient[0]).toBeCloseTo(leftDx, 5);
+  }
+});
