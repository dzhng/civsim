+    iy = Math.floor(gy),
+    tx = gx - ix,
+    ty = gy - iy;
+  const mirror = (i: number, count: number) =>
+    Math.max(0, Math.min(count - 1, i < 0 ? -i : i >= count ? 2 * count - 2 - i : i));
+  const get = (i: number, j: number) =>
+    source.height[mirror(j, source.h) * source.w + mirror(i, source.w)];
+  const rows = [0, 0, 0, 0],
+    rowDx = [0, 0, 0, 0];
+  for (let row = 0; row < 4; row++) {
+    const a = get(ix - 1, iy + row - 1),
+      b = get(ix, iy + row - 1);
+    const c = get(ix + 1, iy + row - 1),
+      d = get(ix + 2, iy + row - 1);
