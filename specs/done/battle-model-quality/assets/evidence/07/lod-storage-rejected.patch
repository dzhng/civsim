+test("LOD result storage is reused while changed views overwrite visibility and counts", () => {
+  const instances = [body(0, 150), body(0, -100)];
+  const storage = createCrowdLodPlan();
+  const first = planPhotorealCrowdLods(storage, instances, [mainView(), shadowView()], assets);
+  const assignments = first.assignments.slice();
+  const shadowAssignments = first.shadowAssignments.slice();
+  const visibility = first.visibility;
+  const next = planPhotorealCrowdLods(storage, instances, [], assets);
+  assert.equal(next, first);
+  assert.equal(next.visibility, visibility);
+  next.assignments.forEach((assignment, i) => assert.equal(assignment, assignments[i]));
+  next.shadowAssignments.forEach((assignment, i) => assert.equal(assignment, shadowAssignments[i]));
+  assert.deepEqual(Array.from(next.visibility), [0, 0]);
+  assert.deepEqual(next.counts, { l0: 0, l1: 0, l2: 0, l3: 2 });
+  assert.deepEqual(next.shadowCounts, { l0: 0, l1: 0, l2: 0, l3: 0 });
+});
+
+test("LOD scratch retains capacity through empty frames and overwrites reactivated slots", () => {
+  const storage = createCrowdLodPlan();
+  const original = [body(0, 10), body(0, 150), body(0, 1000)];
+  planPhotorealCrowdLods(storage, original, [mainView(), shadowView()], assets);
+  const assignments = storage.assignments.slice();
+  const shadowAssignments = storage.shadowAssignments.slice();
+  const visibility = storage.visibility;
+  for (const count of [1, 0, 3]) {
+    const instances = original.slice(0, count).map((instance) => ({ ...instance, y: -100 }));
+    const plan = planPhotorealCrowdLods(
+      storage,
+      instances,
+      [mainView()],
+      assets,
+      [],
+      undefined,
+      [],
+    );
+    assert.equal(plan.count, count);
+    assert.equal(plan.visibility, visibility);
+    assert.deepEqual(Array.from(plan.visibility.slice(0, count)), Array(count).fill(0));
+    assert.deepEqual(plan.counts, { l0: 0, l1: 0, l2: 0, l3: count });
+    assert.deepEqual(plan.shadowCounts, { l0: 0, l1: 0, l2: 0, l3: 0 });
+    for (let i = 0; i < count; i++) {
+      assert.equal(plan.assignments[i], assignments[i]);
+      assert.equal(plan.shadowAssignments[i], shadowAssignments[i]);
+      assert.deepEqual(plan.assignments[i], { level: 3, screenSize: 2.25 });
+      assert.deepEqual(plan.shadowAssignments[i], { level: 3, screenSize: 2.25 });
+    }
+  }
+  const grown = planPhotorealCrowdLods(storage, [...original, body(0, 300)], [mainView()], assets);
+  assert.equal(grown.count, 4);
+  assert.deepEqual(
+    grown.assignments.map((a) => a.level),
+    [0, 1, 3, 2],
+  );
+  assert.deepEqual(grown.counts, { l0: 1, l1: 1, l2: 1, l3: 1 });
+  assert.equal(grown.assignments[2], assignments[2]);
+  assert.notEqual(grown.visibility, visibility);
+});
+
