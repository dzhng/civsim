#!/usr/bin/env bash
# Fast physics-invariant tests (mechanics_*): geometry, facing, cohesion,
# pressure, symmetry, fatigue, morale-mechanism, charge, trample, weave.
# This is the loop you run while changing SIM PHYSICS — keep it fast.
# Pass extra args through, e.g.: scripts/test-mechanics trample -- --nocapture
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
flags=()
for f in crates/sim/tests/mechanics_*.rs; do
  flags+=(--test "$(basename "$f" .rs)")
done
echo "→ cargo test -p sim ${flags[*]}"
exec cargo test -p sim "${flags[@]}" "$@"
