+        distance = ((math.atan2(d*.023,a)-phase)%math.tau)/math.tau*lengths[-1]
+        i = next(i for i in range(len(boundary)) if lengths[i] <= distance <= lengths[i+1])
+        fraction = (distance-lengths[i])/(lengths[i+1]-lengths[i])
+        return boundary[i].lerp(boundary[(i+1)%len(boundary)],fraction)+along*.006
