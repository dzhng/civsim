+  const valleyAt = (x: number, y: number) => {
+    const gx = Math.floor((x - source.minX - source.cell * 0.5) / spacing),
+      gy = Math.floor((source.maxY - y - source.cell * 0.5) / spacing);
+    let cut = 0;
+    for (let j = gy - 2; j <= gy + 2; j++) {
+      for (let i = gx - 2; i <= gx + 2; i++) {
+        const h = heightAtNode(i, j);
+        if (!Number.isFinite(h) || h <= 2.2) continue;
+        let ni = i,
+          nj = j,
+          descent = 0;
+        for (let dy = -1; dy <= 1; dy++) {
+          for (let dx = -1; dx <= 1; dx++) {
+            if (!dx && !dy) continue;
+            const drop = (h - heightAtNode(i + dx, j + dy)) / Math.hypot(dx, dy);
+            if (drop > descent) {
+              descent = drop;
+              ni = i + dx;
+              nj = j + dy;
+            }
+          }
+        }
+        if (ni === i && nj === j) continue;
+        const ax = nodeX(i, j),
+          ay = nodeY(i, j),
+          dx = nodeX(ni, nj) - ax,
+          dy = nodeY(ni, nj) - ay;
+        const t = Math.max(0, Math.min(1, ((x - ax) * dx + (y - ay) * dy) / (dx * dx + dy * dy)));
+        const distance = Math.hypot(x - ax - t * dx, y - ay - t * dy);
+        const width = spacing * (0.2 + hash2(i - 31, j + 23) * 0.1);
