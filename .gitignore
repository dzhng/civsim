.DS_Store

/target
node_modules/
web/dist/
web/src/wasm/

# throwaway debug/probe tests (write-tests skill) — never commit
crates/*/tests/dbg*.rs
# throwaway scratch: one-off probes, data dumps, plots, notes — never commit.
# (Committed tools live in src/bin or the test buckets, NOT here.) The folder
# itself is kept (its README), but everything dropped in it is ignored.
/throwaway/*
!/throwaway/README.md

# highlighted pixel diffs from a failed snapCheck (regenerated every run)
web/shots/diff/

# perf/scenario reports regenerated every run by the full-game-rendering-performance
# scene and scenario:renderer (consumed by the release/cutover audit scripts at run
# time, never reviewed by hand). The tracked README + *.example.json baseline stay.
web/reports/rendering/performance/full-game-rendering-performance.json
web/reports/rendering/rendering-performance-report.html
web/reports/rendering/scenario-runs/
