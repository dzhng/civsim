+async function composedBattle(ctx, { map, x, y, cover }) {
+  const page = await ctx.newPage({
+    viewport: { width: 1280, height: 800 },
+    deviceScaleFactor: 1,
+    errorPrefix: `authored-${map}-composed`,
+  });
+  try {
+    // The public legacy deep links support A/B; C is an existing renderer
+    // fixture, so its full composition uses the same physical battle world.
+    if (map === "C") {
+      const params = new URLSearchParams({
+        map,
+        ref: "1",
+        env: "golden-hour",
+        t: "0",
+        ticks: "60",
+        zoom: "7.8",
+        cx: String(x),
+        cy: String(y),
+        camYaw: String(-Math.PI / 2),
+      });
+      await page.goto(`${ctx.target}/renderer/photoreal-battle?${params}`);
+      await page.waitForFunction(
+        () => window.__rendererLabReady === true && window.__rendererLabStats?.ok === true,
+        undefined,
+        { timeout: 180000 },
+      );
+      await page.evaluate(() => window.__photorealBattleWorld.settlePresentedFrame());
+      const terrain = await page.evaluate(
+        () => window.__rendererLabStats.stats.renderStats.terrain,
+      );
+      ctx.check(
+        "C: full physical battle retains authored yellow-grass and null gameplay slope",
+        terrain.groundCover === cover &&
+          terrain.slopeBands === null &&
+          terrain.scenery > 0 &&
+          terrain.grass?.recordCount > 0,
+        JSON.stringify(terrain),
+      );
+      await ctx.snap(null, "landscape-character/authored-C-composed", {
+        shot: await page.screenshot({ timeout: 180000 }),
+        threshold: 0,
+        maxDiffRatio: 0,
+      });
+      return;
+    }
+    await page.goto(`${ctx.target}/?map=${map}&ai=off`);
+    await page.waitForFunction(
+      () => window.__ready === true && window.__game?.stats().renderStats?.ready === true,
+      undefined,
+      { timeout: 180000 },
+    );
+    await page.evaluate(
+      async ({ x, y }) => {
+        await window.__game.freezeAtTick(60);
+        window.__game.setCamera(x, y, 7.8, -Math.PI / 2, 0.305);
+      },
+      { x, y },
+    );
+    await page.waitForTimeout(250);
+    await page.evaluate(() => window.__game.freezeAtTick(window.__game.tickCount()));
+    const state = await page.evaluate(() => ({
+      stats: window.__game.stats(),
+      terrain: window.__game.terrainDebug(),
+      camera: window.__game.cameraSurfaceDebug(),
+    }));
+    const rendered = state.stats.renderStats;
+    ctx.check(
+      `${map}: production terrain, scenery, grass and army remain composed`,
+      rendered.terrain?.groundCover === cover &&
+        rendered.terrain?.slopeBands === null &&
+        rendered.terrain?.scenery > 0 &&
+        rendered.terrain?.grass?.recordCount > 0 &&
+        rendered.soldiers === state.stats.soldiers &&
+        rendered.soldiers > 0,
+      JSON.stringify(state),
+    );
+    // Full production grass can exceed Playwright's default capture timeout on
+    // software adapters; the composed generated-map gate uses the same bound.
+    const shot = await page.screenshot({ timeout: 180000 });
+    await ctx.snap(null, `landscape-character/authored-${map}-composed`, {
+      shot,
+      threshold: 0,
+      maxDiffRatio: 0,
+    });
+  } finally {
+    await page.close();
   }
 }
