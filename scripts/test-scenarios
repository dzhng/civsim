#!/usr/bin/env bash
# Behavioral-contract tests (*scenarios): public-API emergence end to end.
# Slower than mechanics (some boot full battles) — run when you change a
# player-visible behavior. To run ONE bucket, call cargo directly, e.g.:
#   cargo test -p sim --test combat_scenarios
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
flags=()
for f in crates/sim/tests/*scenarios.rs; do
  flags+=(--test "$(basename "$f" .rs)")
done
echo "→ cargo test -p sim ${flags[*]}"
exec cargo test -p sim "${flags[@]}" "$@"
