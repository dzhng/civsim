diff --git a/crates/sim/src/bin/sim_tick_30k.rs b/crates/sim/src/bin/sim_tick_30k.rs
new file mode 100644
index 00000000..b3987db3
--- /dev/null
+++ b/crates/sim/src/bin/sim_tick_30k.rs
@@ -0,0 +1,363 @@
+use std::env;
+use std::f32::consts::FRAC_PI_2;
+use std::hint::black_box;
+use std::time::{Duration, Instant};
+
+use sim::{build_map, Battle, MapId, Sim, Tunables, Vec2};
+
+const SEED: u64 = 0x5eed_c0de;
+const BALANCED_TEMPLATE: &[(usize, usize)] = &[
+    (12, 4), // Medium Infantry
+    (13, 4), // Medium Spear
+    (4, 3),  // Archers
+    (5, 2),  // Skirmishers
+    (6, 2),  // Shock Cavalry
+    (0, 1),  // Heavy Sword
+    (3, 1),  // Heavy Phalanx
+];
+
+#[derive(Clone, Copy, Debug)]
+enum Scenario {
+    Idle,
+    Fighting,
+}
+
+impl Scenario {
+    fn label(self) -> &'static str {
+        match self {
+            Scenario::Idle => "idle",
+            Scenario::Fighting => "fighting",
+        }
+    }
+}
+
+#[derive(Debug)]
+struct Args {
+    soldiers: Vec<usize>,
+    scenarios: Vec<Scenario>,
+    ticks: usize,
+    warmup: usize,
+    repeats: usize,
+}
+
+#[derive(Clone, Debug)]
+struct UnitPick {
+    class_id: usize,
+    soldiers: usize,
+}
+
+#[derive(Debug)]
+struct RunSummary {
+    scenario: Scenario,
+    requested_soldiers: usize,
+    actual_soldiers: usize,
+    units: usize,
+    repeat: usize,
+    ticks: usize,
+    warmup: usize,
+    total_ms: f64,
+    mean_ms: f64,
+    min_ms: f64,
+    p50_ms: f64,
+    p95_ms: f64,
+    max_ms: f64,
+    stdev_ms: f64,
+    stages: Vec<StageSummary>,
+}
+
+#[derive(Debug)]
+struct StageSummary {
+    label: &'static str,
+    calls: u64,
+    mean_ms: f64,
+    pct_of_wall: f64,
+}
+
+fn main() {
+    let args = parse_args();
+    println!(
+        "command: cargo run --release -p sim --features perf_timing --bin sim_tick_30k -- {}",
+        env::args().skip(1).collect::<Vec<_>>().join(" ")
+    );
+    println!(
+        "seed: 0x{SEED:x}, ticks: {}, warmup: {}, repeats: {}",
+        args.ticks, args.warmup, args.repeats
+    );
+    println!();
+    println!("## Runs");
+    println!(
+        "| scenario | requested | actual soldiers | units | repeat | mean ms/tick | p50 | p95 | min | max | stdev |"
+    );
+    println!("|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|");
+
+    let mut summaries = Vec::new();
+    for &scenario in &args.scenarios {
+        for &soldiers in &args.soldiers {
+            for repeat in 1..=args.repeats {
+                let summary = run_once(scenario, soldiers, repeat, args.ticks, args.warmup);
+                println!(
+                    "| {} | {} | {} | {} | {} | {:.3} | {:.3} | {:.3} | {:.3} | {:.3} | {:.3} |",
+                    summary.scenario.label(),
+                    summary.requested_soldiers,
+                    summary.actual_soldiers,
+                    summary.units,
+                    summary.repeat,
+                    summary.mean_ms,
+                    summary.p50_ms,
+                    summary.p95_ms,
+                    summary.min_ms,
+                    summary.max_ms,
+                    summary.stdev_ms,
+                );
+                summaries.push(summary);
+            }
+        }
+    }
+
+    println!();
+    println!("## Stage Breakdown");
+    for summary in summaries {
+        println!();
+        println!(
+            "### {} requested={} actual={} repeat={} ticks={} warmup={} total_ms={:.3}",
+            summary.scenario.label(),
+            summary.requested_soldiers,
+            summary.actual_soldiers,
+            summary.repeat,
+            summary.ticks,
+            summary.warmup,
+            summary.total_ms
+        );
+        println!("| stage | calls | mean ms/tick | % wall |");
+        println!("|---|---:|---:|---:|");
+        for stage in summary.stages.iter().take(24) {
+            println!(
+                "| {} | {} | {:.3} | {:.1} |",
+                stage.label, stage.calls, stage.mean_ms, stage.pct_of_wall
+            );
+        }
+    }
+}
+
+fn parse_args() -> Args {
+    let mut soldiers = vec![5_000, 15_000, 30_000, 60_000];
+    let mut scenarios = vec![Scenario::Idle, Scenario::Fighting];
+    let mut ticks = 300;
+    let mut warmup = 60;
+    let mut repeats = 2;
+    let mut it = env::args().skip(1);
+    while let Some(arg) = it.next() {
+        match arg.as_str() {
+            "--soldiers" => {
+                soldiers = parse_usize_list(&it.next().expect("--soldiers needs a comma list"));
+            }
+            "--scenario" => {
+                let raw = it.next().expect("--scenario needs idle, fighting, or both");
+                scenarios = match raw.as_str() {
+                    "idle" => vec![Scenario::Idle],
+                    "fighting" => vec![Scenario::Fighting],
+                    "both" => vec![Scenario::Idle, Scenario::Fighting],
+                    _ => panic!("unknown scenario {raw:?}; expected idle, fighting, or both"),
+                };
+            }
+            "--ticks" => ticks = parse_usize_arg("--ticks", it.next()),
+            "--warmup" => warmup = parse_usize_arg("--warmup", it.next()),
+            "--repeats" => repeats = parse_usize_arg("--repeats", it.next()),
+            "--help" | "-h" => {
+                print_help();
+                std::process::exit(0);
+            }
+            _ => panic!("unknown arg {arg:?}; use --help"),
+        }
+    }
+    Args {
+        soldiers,
+        scenarios,
+        ticks,
+        warmup,
+        repeats,
+    }
+}
+
+fn parse_usize_arg(name: &str, raw: Option<String>) -> usize {
+    raw.unwrap_or_else(|| panic!("{name} needs a value"))
+        .parse()
+        .unwrap_or_else(|_| panic!("{name} must be an integer"))
+}
+
+fn parse_usize_list(raw: &str) -> Vec<usize> {
+    raw.split(',')
+        .map(|part| {
+            part.trim()
+                .parse()
+                .expect("--soldiers entries must be integers")
+        })
+        .collect()
+}
+
+fn print_help() {
+    println!("Usage: sim_tick_30k [--soldiers 5000,15000,30000,60000] [--scenario idle|fighting|both] [--ticks 300] [--warmup 60] [--repeats 2]");
+}
+
+fn run_once(
+    scenario: Scenario,
+    requested_soldiers: usize,
+    repeat: usize,
+    ticks: usize,
+    warmup: usize,
+) -> RunSummary {
+    let picks = picks_for_target(requested_soldiers / 2);
+    let actual_soldiers = picks.iter().map(|p| p.soldiers).sum::<usize>() * 2;
+    let units = picks.len() * 2;
+    let mut battle = build_battle(scenario, &picks);
+
+    for _ in 0..warmup {
+        battle.tick();
+        black_box(battle.sim.tick_count);
+    }
+
+    sim::profile::clear();
+    let mut samples = Vec::with_capacity(ticks);
+    let run_start = Instant::now();
+    for _ in 0..ticks {
+        let tick_start = Instant::now();
+        battle.tick();
+        black_box(battle.sim.tick_count);
+        samples.push(tick_start.elapsed());
+    }
+    let total = run_start.elapsed();
+    let stages = summarize_stages(sim::profile::snapshot(), ticks, total);
+    let stats = summarize_samples(&samples);
+
+    RunSummary {
+        scenario,
+        requested_soldiers,
+        actual_soldiers,
+        units,
+        repeat,
+        ticks,
+        warmup,
+        total_ms: ms(total),
+        mean_ms: ms(total) / ticks as f64,
+        min_ms: stats.min_ms,
+        p50_ms: stats.p50_ms,
+        p95_ms: stats.p95_ms,
+        max_ms: stats.max_ms,
+        stdev_ms: stats.stdev_ms,
+        stages,
+    }
+}
+
+fn picks_for_target(target_per_side: usize) -> Vec<UnitPick> {
+    let mut sequence = Vec::new();
+    for &(class_id, count) in BALANCED_TEMPLATE {
+        for _ in 0..count {
+            sequence.push(class_id);
+        }
+    }
+
+    let mut picks = Vec::new();
+    let mut total = 0usize;
+    let mut i = 0usize;
+    while total < target_per_side {
+        let class_id = sequence[i % sequence.len()];
+        let class = contract::ALL_CLASSES[class_id];
+        let soldiers = contract::unit_size(class) as usize;
+        total += soldiers;
+        picks.push(UnitPick { class_id, soldiers });
+        i += 1;
+    }
+    picks
+}
+
+fn build_battle(scenario: Scenario, picks: &[UnitPick]) -> Battle {
+    let mut sim = Sim::new(Tunables::default(), SEED);
+    sim.terrain = build_map(MapId::RiverAndCrags);
+    spawn_side(&mut sim, scenario, picks, 0);
+    spawn_side(&mut sim, scenario, picks, 1);
+    Battle::from_sim(sim)
+}
+
+fn spawn_side(sim: &mut Sim, scenario: Scenario, picks: &[UnitPick], team: u32) {
+    let y = match (scenario, team) {
+        (Scenario::Idle, 0) => -260.0,
+        (Scenario::Idle, _) => 260.0,
+        (Scenario::Fighting, 0) => -12.0,
+        (Scenario::Fighting, _) => 12.0,
+    };
+    let facing = if team == 0 { FRAC_PI_2 } else { -FRAC_PI_2 };
+    let spread = (picks.len() as f32 * 70.0).clamp(200.0, 1700.0);
+    for (i, pick) in picks.iter().enumerate() {
+        let x = if picks.len() > 1 {
+            -spread / 2.0 + (spread * i as f32) / (picks.len() as f32 - 1.0)
+        } else {
+            0.0
+        };
+        let files = (pick.soldiers as f32 * 1.6).sqrt().round().max(6.0) as usize;
+        let class = contract::ALL_CLASSES[pick
+            .class_id
+            .min(contract::ALL_CLASSES.len().saturating_sub(1))];
+        sim.spawn_class_with_files(Vec2::new(x, y), facing, pick.soldiers, files, class, team);
+    }
+}
+
+#[derive(Debug)]
+struct SampleStats {
+    min_ms: f64,
+    p50_ms: f64,
+    p95_ms: f64,
+    max_ms: f64,
+    stdev_ms: f64,
+}
+
+fn summarize_samples(samples: &[Duration]) -> SampleStats {
+    let mut ms_samples: Vec<f64> = samples.iter().map(|&d| ms(d)).collect();
+    ms_samples.sort_by(|a, b| a.total_cmp(b));
+    let mean = ms_samples.iter().sum::<f64>() / ms_samples.len() as f64;
+    let variance = ms_samples
+        .iter()
+        .map(|v| {
+            let d = v - mean;
+            d * d
+        })
+        .sum::<f64>()
+        / ms_samples.len() as f64;
+    SampleStats {
+        min_ms: *ms_samples.first().unwrap(),
+        p50_ms: percentile(&ms_samples, 0.50),
+        p95_ms: percentile(&ms_samples, 0.95),
+        max_ms: *ms_samples.last().unwrap(),
+        stdev_ms: variance.sqrt(),
+    }
+}
+
+fn summarize_stages(
+    timings: Vec<sim::profile::StageTiming>,
+    ticks: usize,
+    total: Duration,
+) -> Vec<StageSummary> {
+    let total_ms = ms(total);
+    let mut stages: Vec<StageSummary> = timings
+        .into_iter()
+        .map(|timing| {
+            let stage_ms = ms(timing.total);
+            StageSummary {
+                label: timing.label,
+                calls: timing.calls,
+                mean_ms: stage_ms / ticks as f64,
+                pct_of_wall: 100.0 * stage_ms / total_ms,
+            }
+        })
+        .collect();
+    stages.sort_by(|a, b| b.mean_ms.total_cmp(&a.mean_ms));
+    stages
+}
+
+fn percentile(sorted: &[f64], q: f64) -> f64 {
+    let idx = ((sorted.len() - 1) as f64 * q).round() as usize;
+    sorted[idx.min(sorted.len() - 1)]
+}
+
+fn ms(duration: Duration) -> f64 {
+    duration.as_secs_f64() * 1000.0
+}
