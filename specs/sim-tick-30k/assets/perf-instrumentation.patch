+//! Feature-gated native tick timing for performance investigations.
+//!
+//! This module is compiled only with `--features perf_timing`. It records wall
+//! time in thread-local counters so benchmark binaries can profile the real sim
+//! pipeline without adding fields or branches to normal builds.
+
+use std::cell::RefCell;
+use std::time::Duration;
+
+#[derive(Clone, Debug)]
+pub struct StageTiming {
+    pub label: &'static str,
+    pub calls: u64,
+    pub total: Duration,
+}
+
+thread_local! {
+    static TIMINGS: RefCell<Vec<StageTiming>> = const { RefCell::new(Vec::new()) };
+}
+
+pub fn clear() {
+    TIMINGS.with(|timings| timings.borrow_mut().clear());
+}
+
+pub fn record(label: &'static str, elapsed: Duration) {
+    TIMINGS.with(|timings| {
+        let mut timings = timings.borrow_mut();
+        if let Some(stage) = timings.iter_mut().find(|stage| stage.label == label) {
+            stage.calls += 1;
+            stage.total += elapsed;
+        } else {
+            timings.push(StageTiming {
+                label,
+                calls: 1,
+                total: elapsed,
+            });
+        }
+    });
+}
+
+pub fn snapshot() -> Vec<StageTiming> {
+    TIMINGS.with(|timings| timings.borrow().clone())
+}
