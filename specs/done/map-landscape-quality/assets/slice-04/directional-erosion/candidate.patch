+/** C1 height reconstruction; cover/color channels retain their bilinear sampler.
+ * Mirrored end samples give zero boundary slope before the field clamps outside. */
+export function campaignHeightSample(
+  source: CampaignReliefSource,
+  x: number,
+  y: number,
+  gradient: [number, number],
+) {
+  const gx = Math.max(0, Math.min(source.w - 1, (x - source.minX) / source.cell - 0.5));
+  const gy = Math.max(0, Math.min(source.h - 1, (source.maxY - y) / source.cell - 0.5));
